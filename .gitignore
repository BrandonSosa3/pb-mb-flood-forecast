# Python environment (rebuilt from requirements.txt, never committed)
.venv/
__pycache__/
*.pyc

# Raw downloads can be large (LiDAR!) and can always be re-downloaded
data/raw/*
!data/raw/.gitkeep

# Mac / editor clutter
.DS_Store
.vscode/

# Large rasters are rebuilt by pipeline/dem_prepare.py (their .meta.json files are kept)
data/processed/*.tif

# Raw phone videos stay local (large; may show people). Stills/clips made from them are committed.
docs/evidence/media/**/*.mov
docs/evidence/media/**/*.MOV

# Rebuilt by pipeline/verify_forecasts.py (grows every run; the summary docs/evidence/wave_check.md is kept)
data/processed/wave_verification.csv
data/processed/*.npy
data/processed/flood_reports.csv
